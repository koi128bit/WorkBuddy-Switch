ObjC.import('AppKit');
ObjC.import('Foundation');
function run(args) {
  var ownPID=Number(args[0]);
  function peers() {
    var apps=$.NSRunningApplication.runningApplicationsWithBundleIdentifier('com.koi128bit.workbuddy-switch'),result=[];
    for(var i=0;i<Number(apps.count);i++){
      var app=apps.objectAtIndex(i);
      if(Number(app.processIdentifier)!==ownPID&&!app.terminated)result.push(app);
    }
    return result;
  }
  var others=peers();
  if(!others.length)return 'ok';
  try {
    var raw=$.NSString.stringWithContentsOfFileEncodingError(args[1]+'/task-run.json',$.NSUTF8StringEncoding,null);
    if(JSON.parse(ObjC.unwrap(raw)).run.status==='running')return 'busy';
  }catch(error){}
  for(var i=0;i<others.length;i++)void others[i].terminate;
  var end=Date.now()+20000;
  while(peers().length&&Date.now()<end)$.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.2));
  return peers().length?'running':'ok';
}
